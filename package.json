    },
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "saare",
        "l7-firewall",
        "ai-governance",
        "dora",
        "gdpr"
    ],
    "author": "Alfonso Ferrer Torres <legal@saare.es>",
