    "homepage": "https://github.com/saare-protocol/n8n-nodes-execution-guard#readme",
    "bugs": {
        "url": "https://github.com/saare-protocol/n8n-nodes-execution-guard/issues"
    },
    "n8n": {
        "n8nNodesApiVersion": 1,
        "nodes": [
            "dist/nodes/SaareExecutionGuard/SaareExecutionGuard.node.js"
